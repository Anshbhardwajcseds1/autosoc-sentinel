# AutoSOC Sentinel - Environment Configuration
# Copy this file to .env and fill in your values

# LLM Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# Threat Intelligence APIs (optional - mock mode works without these)
VIRUSTOTAL_API_KEY=your-virustotal-api-key-here
ABUSEIPDB_API_KEY=your-abuseipdb-api-key-here

# Mode Configuration
MOCK_MODE=true
LLM_MOCK_MODE=true

# Application Settings
DATABASE_URL=sqlite:///./autosoc.db
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Allowlist Configuration
ANALYST_IPS=192.168.1.100,10.0.0.50
ADMIN_ACCOUNTS=admin,soc-admin,service-account

# API Settings
API_HOST=0.0.0.0
API_PORT=8000
